        -mensagem: String
        -dataEnvio: Date
    }

    metodos{
        +visualizar(): void
    }

    relacoesEMultiplicidades{
        Notificacao "*" --> "1" Aluno
    }
}

Classe ServicoAutenticacao [classe]{
    atributos{
        -token: String
    }

    metodos{
        +validarLogin(): boolean
        +gerarSessao(): void
    }

    relacoesEMultiplicidades{
        ServicoAutenticacao --> Usuario
    }
}

Classe ServicoPagamento [classe]{
