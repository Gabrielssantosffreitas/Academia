    }

    relacoesEMultiplicidades{
        FichaTreino "*" --> "1" Aluno
        FichaTreino "*" --> "1" PersonalProfessor
        FichaTreino "1" --> "*" Exercicio
    }
}

Classe Exercicio [classe]{
    atributos{
        -idExercicio: int
        -nome: String
        -series: int
        -repeticoes: int
    }

    metodos{
        +adicionarExercicio(): void
        +editarExercicio(): void
    }

    relacoesEMultiplicidades{
        Exercicio "*" --> "1" FichaTreino
    }
}

Classe QRCode [classe]{
    atributos{
        -codigo: String
        -dataGeracao: Date
        -ativo: boolean
    }

    metodos{
        +gerar(): void
        +validar(): boolean
    }

    relacoesEMultiplicidades{
        QRCode "1" --> "1" Aluno
    }
}

Classe Notificacao [classe]{
    atributos{
